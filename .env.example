# ---- MnM Tickets environment configuration (placeholders only; never commit real values) ----

# Port and bind for the application server.
# Render/containers need BIND_HOST=0.0.0.0 (production defaults to 0.0.0.0 if omitted).
PORT=8787
BIND_HOST=127.0.0.1

# Comma-separated origins allowed to make state-changing requests (CSRF/origin check).
# In production this must be the public site origin.
# In development the localhost / 127.0.0.1 / [::1] aliases of a loopback origin
# are accepted automatically, so either local URL can sign in and check out.
PUBLIC_ORIGINS=http://localhost:8787,http://127.0.0.1:8787

# Cryptographic master secret for session tokens, guest-order links and QR integrity.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET_KEY=change-me-32-bytes-hex

# Node environment: development | production (must be production for anything public)
NODE_ENV=development

# ---- Database ----
# Local SQLite database file (development). The app uses node:sqlite; in
# production put this file on a persistent disk (see docs/MNM_DEPLOYMENT_READINESS.md).
DATABASE_FILE=data/mnm-dev.sqlite

# ---- Payments (Safaricom Daraja / M-Pesa STK Push) ----
# Required and fail-closed:
#   dev      = clearly-labelled DEVELOPMENT SIMULATOR (local/test only; refused in production)
#   daraja   = live Safaricom M-Pesa (requires all five MPESA_* credentials)
#   disabled = production-safe mode: no payment is initiated and ticket checkout is refused
#              before creating an order. Juice ordering and staff workflows still work.
PAYMENT_PROVIDER=dev
# Optional dev-only simulator result: success or failure (leave empty otherwise).
PAYMENT_DEV_FORCE_STATUS=

MPESA_ENV=sandbox               # sandbox | production
MPESA_SHORTCODE=                # Paybill / Till used for STK push
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_CALLBACK_BASE=            # publicly reachable HTTPS base URL for callbacks
MPESA_PASSKEY=                  # Daraja API passkey for the shortcode

# ---- Notifications ----
# EMAIL_PROVIDER / SMS_PROVIDER: console | smtp / africastalk-zimbra etc.
# 'console' writes a clearly-labelled line into the local log; nothing is delivered.
EMAIL_PROVIDER=console
SMS_PROVIDER=console
SMTP_URL=
SMS_API_BASE=
SMS_API_KEY=
NOTIFY_FROM=info@example.com
