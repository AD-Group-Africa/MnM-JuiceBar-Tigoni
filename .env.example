# ---- MnM Tickets environment configuration (placeholders only; never commit real values) ----

# Port and bind for the application server
PORT=8787
BIND_HOST=127.0.0.1

# Comma-separated origins allowed to make state-changing requests (CSRF/origin check).
# In production this must be the public site origin.
PUBLIC_ORIGINS=http://localhost:8787

# Cryptographic master secret for session tokens, guest-order links and QR integrity.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET_KEY=change-me-32-bytes-hex

# Node environment: development | production (must be production for anything public)
NODE_ENV=development

# ---- Database ----
# Local SQLite database file (development). In production use PostgreSQL;
# see docs/ARCHITECTURE.md for the migration story.
DATABASE_FILE=data/mnm-dev.sqlite

# ---- Payments (Safaricom Daraja / M-Pesa STK Push) ----
# Leave empty to run with the clearly-labelled DEVELOPMENT SIMULATOR payment adapter
# (test only, never presented as real money).
PAYMENT_PROVIDER=dev            # dev | daraja
PAYMENT_DEV_FORCE_STATUS=       # optionally force: success|failure for the dev adapter

MPESA_ENV=sandbox               # sandbox | production
MPESA_SHORTCODE=                # Paybill / Till used for STK push
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_CALLBACK_BASE=            # publicly reachable HTTPS base URL for callbacks
MPESA_PASSKEY=                  # Daraja API passkey for the shortcode

# ---- Notifications ----
# EMAIL_PROVIDER / SMS_PROVIDER: console | smtp / africastalk-zimbra etc.
# 'console' writes a clearly-labelled line into the local log; nothing is delivered.
EMAIL_PROVIDER=console
SMS_PROVIDER=console
SMTP_URL=
SMS_API_BASE=
SMS_API_KEY=
NOTIFY_FROM=info@example.com
